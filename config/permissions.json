{
  "file_permissions": {
    "allowed_read_dirs": [
      "${WORKSPACE}\\workspace\\input",
      "${WORKSPACE}\\workspace\\output",
      "%USERPROFILE%\\Desktop",
      "%USERPROFILE%\\Documents",
      "%USERPROFILE%\\Downloads"
    ],
    "allowed_write_dirs": [
      "${WORKSPACE}\\workspace\\output",
      "${WORKSPACE}\\workspace\\temp",
      "%USERPROFILE%\\Desktop",
      "%USERPROFILE%\\Documents"
    ],
    "blocked_dirs": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "%USERPROFILE%\\AppData"
    ],
    "allowed_extensions": [
      ".docx",
      ".xlsx",
      ".pdf",
      ".txt",
      ".png",
      ".jpg",
      ".csv",
      ".json"
    ],
    "max_attachment_mb": 15
  },
  "app_permissions": {
    "cmd": {
      "launch": "confirm",
      "allowed_commands": [
        "dir",
        "where",
        "start",
        "python --version"
      ]
    },
    "powershell": {
      "launch": "confirm",
      "allowed_commands": [
        "Get-Process"
      ]
    },
    "notepad": {
      "launch": "allow"
    },
    "explorer": {
      "launch": "allow"
    },
    "excel": {
      "launch": "allow"
    },
    "word": {
      "launch": "allow"
    }
  },
  "contact_permissions": {
    "nam@example.com": {
      "name": "Sample Director",
      "policy": "confirm_before_send"
    },
    "hang@example.com": {
      "name": "Sample HR",
      "policy": "draft_only"
    },
    "default": {
      "policy": "confirm_before_send"
    }
  },
  "remote_sender_permissions": {
    "telegram:123456789": {
      "name": "Owner",
      "enabled": true,
      "auth_level": "admin",
      "can_create_task": true,
      "can_approve_high_risk": true,
      "requires_pin_for_high_risk": true
    },
    "default": {
      "enabled": false,
      "auth_level": "none"
    }
  },
  "safety_settings": {
    "coordinate_click_enabled": false,
    "remote_gateway_enabled": false,
    "auto_send_messages": false,
    "default_action_policy": "confirm_once"
  }
}